# ================================================================
# Layout Definition File for Chinese (AZERTY) - Ultra Efficient
# ================================================================

# ⚙️ BASIC INFO
INPUT_SOURCE_NAME="Chinese (AZERTY) Pinyin"
SHORT_NAME="CHN"
LANGUAGE_CODE="zh"
COUNTRY_CODE="CN"
FLAG="🇨🇳"

# ============================================================
# الصف الأول (الأرقام) - رموز عالية جداً لا تنتمي لعائلة
# المستوى 1: عالية جداً, 2: عالية, 3: متوسطة, 4: منخفضة
# ============================================================

key <TLDE> { [ U4E2D, U56FD, U6C11, U65CF ] }; // 中 国 民 族 (zhōng guó mín zú)
key <AE01> { [ U515A, U653F, U519B, U961F ] }; // 党 政 军 队 (dǎng zhèng jūn duì)
key <AE02> { [ U5DE5, U519C, U5175, U5B66 ] }; // 工 农 兵 学 (gōng nóng bīng xué)
key <AE03> { [ U5546, U5730, U65B9, U5E02 ] }; // 商 地 方 市 (shāng dì fāng shì)
key <AE04> { [ U65E5, U6708, U661F, U671F ] }; // 日 月 星 期 (rì yuè xīng qī)
key <AE05> { [ U5E74, U65F6, U5206, U79D2 ] }; // 年 时 分 秒 (nián shí fēn miǎo)
key <AE06> { [ U523B, U949F, U70B9, U5468 ] }; // 刻 钟 点 周 (kè zhōng diǎn zhōu)
key <AE07> { [ U4E0A, U4E0B, U5DE6, U53F3 ] }; // 上 下 左 右 (shàng xià zuǒ yòu)
key <AE08> { [ U524D, U540E, U91CC, U5916 ] }; // 前 后 里 外 (qián hòu lǐ wài)
key <AE09> { [ U5927, U5C0F, U957F, U77ED ] }; // 大 小 长 短 (dà xiǎo cháng duǎn)
key <AE10> { [ U9AD8, U4F4E, U5FEB, U6162 ] }; // 高 低 快 慢 (gāo dī kuài màn)
key <AE11> { [ U8FD9, U4E2A, U90A3, U54EA ] }; // 这 个 那 哪 (zhè gè nà nǎ)
key <AE12> { [ U600E, U4E48, U4E3A, U4EC0 ] }; // 怎 么 为 什 (zěn me wèi shén)

# ============================================================
# الصف الثاني: AZERTY (A, Z, E, R, T, Y, U, I, O, P)
# ============================================================

# A: 爱 (ài) حب, 安 (ān) آمن, 按 (àn) يضغط, 暗 (àn) مظلم
key <AD01> { [ U7231, U5B89, U6309, U6697 ] }; // 爱 安 按 暗

# Z: 在 (zài) في, 再 (zài) مرة أخرى, 载 (zài) يحمل, 咱 (zán) نحن
key <AD02> { [ U5728, U518D, U8F7D, U54B1 ] }; // 在 再 载 咱

# E: 而 (ér) و/لكن, 儿 (ér) طفل, 尔 (ěr) أنت, 洱 (ěr) بحيرة
key <AD03> { [ U800C, U513F, U5C14, U6D31 ] }; // 而 儿 尔 洱

# R: 人 (rén) شخص, 日 (rì) شمس, 认 (rèn) يعترف, 任 (rèn) مهمة
key <AD04> { [ U4EBA, U65E5, U8BA4, U4EFB ] }; // 人 日 认 任

# T: 他 (tā) هو, 她 (tā) هي, 它 (tā) هو (غير عاقل), 塔 (tǎ) برج
key <AD05> { [ U4ED6, U5979, U5B83, U5854 ] }; // 他 她 它 塔

# Y: 有 (yǒu) لديه, 又 (yòu) مرة أخرى, 友 (yǒu) صديق, 右 (yòu) يمين
key <AD06> { [ U6709, U53C8, U53CB, U53F3 ] }; // 有 又 友 右

# U: 你 (nǐ) أنت, 那 (nà) ذلك, 哪 (nǎ) أين, 呢 (ne) أداة سؤال
key <AD07> { [ U4F60, U90A3, U54EA, U5462 ] }; // 你 那 哪 呢

# I: 意 (yì) معنى, 易 (yì) سهل, 艺 (yì) فن, 益 (yì) منفعة
key <AD08> { [ U610F, U6613, U827A, U76CA ] }; // 意 易 艺 益

# O: 哦 (ó) تعجب, 噢 (ō) تعجب, 喔 (wō) عش, 卧 (wò) يستلقي
key <AD09> { [ U54E6, U5662, U55F2, U5367 ] }; // 哦 噢 喔 卧

# P: 平 (píng) مسطح, 品 (pǐn) منتج, 凭 (píng) اعتماداً على, 苹 (píng) تفاح
key <AD10> { [ U5E73, U54C1, U51ED, U82F9 ] }; // 平 品 凭 苹

# ^ و $ (مفاتيح خاصة في AZERTY)
key <AD11> { [ U8FD9, U4E2A, U90A3, U54EA ] }; // 这 个 那 哪 (مكرر)
# سأعدل AD11 و AD12 لرموز أخرى:
key <AD11> { [ U8FD9, U90A3, U54EA, U600E ] }; // 这 那 哪 怎
key <AD12> { [ U4E48, U4E3A, U4EC0, U4E48 ] }; // 么 为 什 么

# ============================================================
# الصف الثالث: QSDFGHJKLM + ù + *
# ============================================================

# Q: 去 (qù) يذهب, 前 (qián) أمام, 请 (qǐng) يرجى, 且 (qiě) و/أيضاً
key <AC01> { [ U53BB, U524D, U8BF7, U4E14 ] }; // 去 前 请 且

# AC02: 是 (shì) يكون, 时 (shí) وقت, 事 (shì) شيء/أمر, 说 (shuō) يقول
key <AC02> { [ U662F, U65F6, U4E8B, U8BF4 ] }; // 是 时 事 说

# D: 的 (de) ملكية, 地 (dì) أرض, 得 (de) يجب, 着 (zhe) مستمر
key <AC03> { [ U7684, U5730, U5F97, U7740 ] }; // 的 地 得 着

# F: 发 (fā) يرسل, 法 (fǎ) قانون, 非 (fēi) ليس, 飞 (fēi) يطير
key <AC04> { [ U53D1, U6CD5, U975E, U98DE ] }; // 发 法 非 飞

# G: 过 (guò) يمر, 给 (gěi) يعطي, 各 (gè) كل, 共 (gòng) مشترك
key <AC05> { [ U8FC7, U7ED9, U5404, U5171 ] }; // 过 给 各 共

# H: 好 (hǎo) جيد, 很 (hěn) جداً, 还 (hái) لا يزال, 或 (huò) أو
key <AC06> { [ U597D, U5F88, U8FD8, U6216 ] }; // 好 很 还 或

# J: 家 (jiā) بيت, 见 (jiàn) يرى, 间 (jiān) بين, 将 (jiāng) سوف
key <AC07> { [ U5BB6, U89C1, U95F4, U5C06 ] }; // 家 见 间 将

# K: 看 (kàn) ينظر, 可 (kě) يمكن, 开 (kāi) يفتح, 口 (kǒu) فم
key <AC08> { [ U770B, U53EF, U5F00, U53E3 ] }; // 看 可 开 口

# L: 了 (le) فعل مكتمل, 来 (lái) يأتي, 里 (lǐ) داخل, 老 (lǎo) قديم
key <AC09> { [ U4E86, U6765, U91CC, U8001 ] }; // 了 来 里 老

# M: 吗 (ma) أداة سؤال, 们 (men) جمع, 没 (méi) ليس, 名 (míng) اسم
key <AC10> { [ U5417, U4EEC, U6CA1, U540D ] }; // 吗 们 没 名

# ù (AZERTY): 于 (yú) في/عند, 与 (yǔ) مع, 雨 (yǔ) مطر, 语 (yǔ) لغة
key <AC11> { [ U4E8E, U4E0E, U96E8, U8BED ] }; // 于 与 雨 语

# * (AZERTY): 年 (nián) سنة (حسب طلب المستخدم)
key <BKSL> { [ U5E74, U5E74, U5E74, U5E74 ] }; // 年 年 年 年
# لكن هذا تكرار، سنعدل:
key <BKSL> { [ U5E74, U6708, U65E5, U65F6 ] }; // 年 月 日 时

# ============================================================
# الصف الرابع: WXCVBN + , . ; : !
# ============================================================

# ============================================================
# الصف الرابع: W X C V B N , ; : ! (ترتيب AZERTY الصحيح)
# ============================================================

# < > (LSGT): 小 (xiǎo) صغير, 大 (dà) كبير, 少 (shǎo) قليل, 多 (duō) كثير
key <LSGT> { [ U5C0F, U5927, U5C11, U591A ] }; // 小 大 少 多

# W: 我 (wǒ) أنا, 为 (wèi) من أجل, 问 (wèn) يسأل, 外 (wài) خارج
key <AB01> { [ U6211, U4E3A, U95EE, U5916 ] }; // 我 为 问 外

# AB02: 谢 (xiè) شكراً, 学 (xué) يتعلم, 想 (xiǎng) يفكر, 新 (xīn) جديد
key <AB02> { [ U8C22, U5B66, U60F3, U65B0 ] }; // 谢 学 想 新

# C: 吃 (chī) يأكل, 出 (chū) يخرج, 车 (chē) سيارة, 成 (chéng) يصبح
key <AB03> { [ U5403, U51FA, U8F66, U6210 ] }; // 吃 出 车 成

# V: 这 (zhè) هذا, 那 (nà) ذلك, 哪 (nǎ) أين, 怎 (zěn) كيف
key <AB04> { [ U8FD9, U90A3, U54EA, U600E ] }; // 这 那 哪 怎

# B: 不 (bù) ليس, 吧 (ba) أداة تأكيد, 把 (bǎ) أداة مفعول, 被 (bèi) مبني للمجهول
key <AB05> { [ U4E0D, U5427, U628A, U88AB ] }; // 不 吧 把 被

# N: 你 (nǐ) أنت, 男 (nán) رجل, 女 (nǚ) امرأة, 能 (néng) يستطيع
key <AB06> { [ U4F60, U7537, U5973, U80FD ] }; // 你 男 女 能

# , ? : 和 (hé) و, 与 (yǔ) مع, 同 (tóng) مع, 跟 (gēn) مع
key <AB07> { [ U548C, U4E0E, U540C, U8DDF ] }; // 和 与 同 跟

# ; . : 都 (dōu) كل, 也 (yě) أيضاً, 还 (hái) لا يزال, 就 (jiù) فقط
key <AB08> { [ U90FD, U4E5F, U8FD8, U5C31 ] }; // 都 也 还 就

key <AB09> { [ U5BF9, U9519, U5BF9, U975E ] }; // 对 错 对 非

# ! : 好 (hǎo) جيد, 坏 (huài) سيء, 美 (měi) جميل, 丑 (chǒu) قبيح
key <AB10> { [ U597D, U574F, U7F8E, U4E11 ] }; // 好 坏 美 丑

# ============================================================
# مفاتيح خاصة (لا نعبث بها)
# ============================================================

key <SPCE> { [ space, space, space, space ] };

key <UP>    { [ Up,    Up,    U2191,    U21E7 ] };
key <DOWN>  { [ Down,  Down,  U2193,    U21E9 ] };
key <LEFT>  { [ Left,  Left,  U2190,    U21E6 ] };
key <RGHT>  { [ Right, Right, U2192,    U21E8 ] };

# ============================================================
# Numpad - الأرقام العربية في 1، الصينية في 2، الرومانية في 3، الدائرية في 4
# ============================================================

key <KP7> { [ 7, U4E03, U2166, U277C ] }; // 7 七 Ⅶ ❼
key <KP8> { [ 8, U516B, U2167, U277D ] }; // 8 八 Ⅷ ❽
key <KP9> { [ 9, U4E5D, U2168, U277E ] }; // 9 九 Ⅸ ❾
key <KP4> { [ 4, U56DB, U2163, U2779 ] }; // 4 四 Ⅳ ❹
key <KP5> { [ 5, U4E94, U2164, U277A ] }; // 5 五 Ⅴ ❺
key <KP6> { [ 6, U516D, U2165, U277B ] }; // 6 六 Ⅵ ❻
key <KP1> { [ 1, U4E00, U2160, U2776 ] }; // 1 一 Ⅰ ❶
key <KP2> { [ 2, U4E8C, U2161, U2777 ] }; // 2 二 Ⅱ ❷
key <KP3> { [ 3, U4E09, U2162, U2778 ] }; // 3 三 Ⅲ ❸
key <KP0> { [ 0, U96F6, U2169, U277F ] }; // 0 零 Ⅹ ❿
