# ================================================================
# Layout Definition File for Chinese (AZERTY) - Ultra Efficient
# ================================================================

# ⚙️ BASIC INFO
INPUT_SOURCE_NAME="Chinese (AZERTY) Pinyin"
SHORT_NAME="CHN"
LANGUAGE_CODE="zh"
COUNTRY_CODE="CN"
FLAG="🇨🇳"

# ============================================================
# الصف الأول (الأرقام) - رموز عالية جداً لا تنتمي لعائلة
# المستوى 1: عالية جداً, 2: عالية, 3: متوسطة, 4: منخفضة
# ============================================================

key <TLDE> { [ U4E07, U592A, U5B87, U5B99 ] }; // 万 太 宇 宙 (كثرة/كل شيء، عظيم جداً، فضاء، كون)

# AE01 (مفتاح 1): البداية المطلقة - السنة الجديدة، القمة، الأصل
key <AE01> { [ U5143, U9996, U521D, U59CB ] }; // 元 首 初 始 (بداية، أول، مبتدأ، منشأ)

# AE02 (مفتاح 2): الثنائية والتناغم - الزوجان، المثنى
key <AE02> { [ U53CC, U5BF9, U5076, U4F34 ] }; // 双 对 偶 伴 (زوجي، مقترن، زوج، رفيق)

# AE03 (مفتاح 3): النمو والكثرة - يرمز للحياة المتجددة والأبناء
key <AE03> { [ U751F, U547D, U8FD0, U957F ] }; // 生 命 运 长 (حياة، قدر، حظ، طول/نمو)

# AE04 (مفتاح 4): ☠️ النحس الأكبر - يشبه نطق "الموت" (يُتجنب)
key <AE04> { [ U6B7B, U707E, U7978, U4EA1 ] }; // 死 灾 祸 亡 (موت، بلاء، مصيبة، هلاك)

# AE05 (مفتاح 5): مركز الكون - منتصف الأرقام، يرمز للصين والعناصر الخمسة
key <AE05> { [ U4E2D, U56FD, U534E, U592E ] }; // 中 国 华 央 (وسط، دولة الصين، رونق، مركز)

# AE06 (مفتاح 6): السلاسة والحظ السلس - مثل انسياب الماء
key <AE06> { [ U987A, U5229, U901A, U8FBE ] }; // 顺 利 通 达 (سلس، منفعة، مفتوح، متقدم)

# AE07 (مفتاح 7): الروحانية والنجوم - يرتبط بالقمر والبوذية
key <AE07> { [ U661F, U6708, U591C, U8FB0 ] }; // 星 月 夜 辰 (نجم، قمر، ليل، نجوم/وقت)

# AE08 (مفتاح 8): 🍀 أسعد رقم على الإطلاق - يرمز للثراء المدوي
key <AE08> { [ U8D22, U5BCC, U65FA, U8363 ] }; // 财 富 旺 荣 (مال، غنى، ازدهار، مجد)

# AE09 (مفتاح 9): الكمال والخلود - رقم الإمبراطور
key <AE09> { [ U4E45, U6C38, U6052, U5168 ] }; // 久 永 恒 全 (طويل الأمد، أبدي، دائم، كامل)

# AE10 (مفتاح 0): الفراغ المقدس والكمال الدائري - اللانهاية
key <AE10> { [ U5706, U6EE1, U5B8C, U5468 ] }; // 圆 满 完 周 (دائري، ممتلئ، نهائي، دورة/محيط)

# AE11: أدوات الإشارة الأساسية (لا تتعارض مع الحروف)
key <AE11> { [ U8FD9, U90A3, U54EA, U600E ] }; // 这 那 哪 怎 (هذا، ذاك، أين، كيف)

# AE12: أدوات الربط والعطف (لتجنب التكرار مع الحروف)
key <AE12> { [ U53CA, U5E76, U4E43, U4EA6 ] }; // 及 并 乃 亦 (و، وكذلك، بل، أيضاً)

# ========================================================================
# الصف الثاني (A Z E R T Y U I O P) - حسب أول حرف Pinyin
# ========================================================================

# A: 爱 (ài) حب - الكلمة العاطفية الأولى
key <AD01> { [ U7231, U5B89, U6309, U6697 ] }; // 爱 安 按 暗 (حب، آمن، يضغط، مظلم)

# Z: 在 (zài) في/موجود - الأكثر استخداماً في المحادثات
key <AD02> { [ U5728, U518D, U54B1, U65E9 ] }; // 在 再 咱 早 (في، مرة أخرى، نحن - عامية، صباح)

# E: 儿 (ér) طفل/صغير - تستخدم للتحبيب (مثل 这儿 = هنا)
key <AD03> { [ U513F, U800C, U5C14, U6D31 ] }; // 儿 而 尔 洱 (طفل، لكن، أنت - قديم، بحيرة)

# R: 人 日 忍 任 (شخص، شمس، صبر، مهمة)
key <AD04> { [ U4EBA, U65E5, U5FCD, U4EFB ] }; // 人 日 忍 任

# T: 她 (tā) هي - الأولوية للأنثى (لأنها هي)
key <AD05> { [ U5979, U4ED6, U5B83, U5854 ] }; // 她 他 它 塔 (هي، هو، ضمير غير عاقل، برج)

# Y: 有 (yǒu) لديه - للتعبير عن المشاعر (我有 = لدي)
key <AD06> { [ U6709, U53C8, U53CB, U53F3 ] }; // 有 又 友 右 (لديه، مرة أخرى، صديق، يمين)

# U: 有 (yǒu) لديه - الكلمة الأكثر استخداماً من صوت "يو"
key <AD07> { [ U65E0, U5B87, U5B99, U8FD0 ] }; // 无 宇 宙 运 (لا يوجد، فضاء، كون، حظ/حركة)

# I: 意 (yì) معنى / نية - عميق ورومانسي
key <AD08> { [ U610F, U6613, U827A, U76CA ] }; // 意 易 艺 益 (معنى، سهل، فن، منفعة)

# O: 哦 (ó) - أداة تعجب خفيفة ولطيفة
key <AD09> { [ U54E6, U5662, U55F2, U5367 ] }; // 哦 噢 喔 卧 (تعجب، تعجب ألم، عش، يستلقي)

# P: 平 (píng) هادئ / مسطح - تستخدم في (平安 = سلامة)
key <AD10> { [ U5E73, U54C1, U51ED, U82F9 ] }; // 平 品 凭 苹 (هادئ، منتج/ذوق، اعتماداً على، تفاح)

# ========================================================================
# AD11 (مفتاح ^ - قبعة/سقف) : معاني القمة والارتفاع والظهور
# ========================================================================
# جميع الرموز هنا فريدة ولم تظهر في أي مفتاح آخر
# ========================================================================

key <AD11> { [ U9876, U5CF0, U4E0A, U9762 ] }; // 顶 峰 上 面 (قمة، ذروة، فوق/سطح، سطح/وجه)

# ========================================================================
# AD12 (مفتاح $ - دولار) : معاني المال والجهد والانشغال والربح
# ========================================================================

key <AD12> { [ U8D4C, U8D2A, U5FD9, U8D5A ] }; // 赚 (ربح) 贪 (طمع) 忙 (مشغول) 赢 (فوز)
# ========================================================================
# الصف الثالث (Q S D F G H J K L M ù *)
# ========================================================================

# Q: 请 (qǐng) من فضلك - للأدب واللباقة
key <AC01> { [ U8BF7, U524D, U53BB, U4E14 ] }; // 请 前 去 且 (من فضلك، أمام، يذهب، أيضاً/و)

# S: 是 (shì) يكون - يستخدم 100 مرة في اليوم
key <AC02> { [ U662F, U65F6, U8BF4, U4E8B ] }; // 是 时 说 事 (يكون، وقت، يقول، شيء/أمر)

# D: 的 (de) أداة ملكية - لا يمكن الاستغناء عنها
key <AC03> { [ U7684, U5730, U5F97, U7740 ] }; // 的 地 得 着 (ملكية، أرض، يجب، مستمر)

# F: 发 (fā) يرسل / ينطلق - شائع جداً (发生 = يحدث)
key <AC04> { [ U53D1, U6CD5, U975E, U98DE ] }; // 发 法 非 飞 (يرسل، قانون، ليس، يطير)

# G: 给 (gěi) يعطي - مهم للتعبير عن العطاء
key <AC05> { [ U7ED9, U8FC7, U5404, U5171 ] }; // 给 过 各 共 (يعطي، يمر، كل، مشترك)

# H: 好 (hǎo) جيد - الكلمة اليومية الأولى
key <AC06> { [ U597D, U5F88, U8FD8, U54C8 ] }; // 好 很 还 哈

# J: 家 (jiā) بيت / عائلة - دافئ ورومانسي
key <AC07> { [ U5BB6, U89C1, U95F4, U5C06 ] }; // 家 见 间 将 (بيت، يرى، بين، سوف)

# K: 看 (kàn) ينظر - يستخدم للنظر إليها
key <AC08> { [ U770B, U53EF, U5F00, U53E3 ] }; // 看 可 开 口 (ينظر، يمكن، يفتح، فم)

# L: 了 (le) فعل مكتمل - أهم أداة نحوية
key <AC09> { [ U4E86, U6765, U91CC, U8001 ] }; // 了 来 里 老 (فعل مكتمل، يأتي، داخل، قديم)

# M: 吗 (ma) أداة سؤال - و 美 (měi) جميل
key <AC10> { [ U5417, U7F8E, U6CA1, U540D ] }; // 吗 美 没 名 (أداة سؤال، جميل، ليس، اسم)

# ù (AZERTY): 语 (yǔ) لغة / كلام - للحديث معها
key <AC11> { [ U8BED, U96E8, U4E8E, U4E0E ] }; // 语 雨 于 与 (لغة، مطر، في/عند، مع)

# * (AZERTY): رموز الليل والأحلام (مرتبطة بالنجمة)
key <BKSL> { [ U68A6, U613F, U5E7B, U5E0C ] }; // 梦 愿 幻 希 (حلم، أمنية، خيال، أمل)

# ========================================================================
# الصف الرابع (W X C V B N) + علامات الترقيم المعنوية
# ========================================================================

# < > (LSGT): رموز الكمية الأساسية
key <LSGT> { [ U5927, U5C0F, U591A, U5C11 ] }; // 大 小 多 少 (كبير، صغير، كثير، قليل)

# W: 我 (wǒ) أنا - لا يمكن أن تكون العلاقة بدونها
key <AB01> { [ U6211, U4E3A, U95EE, U5916 ] }; // 我 为 问 外 (أنا، من أجل، يسأل، خارج)

# X: 谢 (xiè) شكر - و 想 (xiǎng) شوق/تفكير
key <AB02> { [ U8C22, U60F3, U5B66, U65B0 ] }; // 谢 想 学 新 (شكراً، يشوق/يفكر، يتعلم، جديد)

# C: 吃 (chī) يأكل - و 出 (chū) يخرج
key <AB03> { [ U5403, U51FA, U8F66, U6210 ] }; // 吃 出 车 成 (يأكل، يخرج، سيارة، يصبح)

# V: (لا يوجد Pinyin لها) → نضع أدوات نحوية عالية التردد لتجنب التكرار
key <AB04> { [ U90FD, U4E5F, U5C31, U521A ] }; // 都 也 就 刚 (كل، أيضاً، فقط، للتو)

# B: 不 (bù) ليس - النفي الأهم
key <AB05> { [ U4E0D, U5427, U628A, U88AB ] }; // 不 吧 把 被 (ليس، أداة تأكيد، أداة مفعول، مبني للمجهول)

# N: 你 (nǐ) أنت - الآن على مفتاح N (أول حرف من Pinyin)
#     + 男/女 للتمييز بين الجنسين، + 心 (أنت -قلب)
key <AB06> { [ U4F60, U7537, U5973, U5FC3 ] }; // 你 男 女 心

# ========================================================================
# علامات الترقيم - مرتبطة بمعانيها التعبيرية
# ========================================================================

# مفتاح الفاصلة (،) : يرمز للعطف والاستمرارية
key <AB07> { [ U548C, U4E0E, U540C, U8DDF ] }; // 和 与 同 跟 (و، مع، مع، مع)

# مفتاح الفاصلة المنقوطة (؛) : يرمز للتوقف المؤقت والربط
key <AB08> { [ U540C, U4E26, U4E14, U800C ] }; // 同 并 且 而 (نفس، و/أيضاً، علاوة على ذلك، لكن)

# مفتاح النقطتين (:) : يرمز للقول والبيان والشرح
key <AB09> { [ U8A00, U8BED, U8BDD, U8BBA ] }; // 言 语 话 论 (قول، لغة، كلام، حديث/نقاش)

# مفتاح التعجب والاستفهام (! و ؟) : يرمزان للدهشة والسؤال
# المستوى 1 = علامة تعجب كاملة العرض ، المستوى 2 = علامة استفهام كاملة العرض
# المستوى 3 = دهشة ، المستوى 4 = استغراب
key <AB10> { [ UFF01, UFF1F, U60CA, U7591 ] }; // ！ ？ 惊 疑 (تعجب، استفهام، صدمة/دهشة، شك/استغراب)

# ========================================================================
# مفاتيح المسافة والاتجاهات
# ========================================================================

key <SPCE> { [ space, space, space, space ] };

key <UP>    { [ Up,    Up,    U2191,    U21E7 ] };
key <DOWN>  { [ Down,  Down,  U2193,    U21E9 ] };
key <LEFT>  { [ Left,  Left,  U2190,    U21E6 ] };
key <RGHT>  { [ Right, Right, U2192,    U21E8 ] };

# ========================================================================
# لوحة الأرقام المنفصلة (Numpad) - الأرقام العربية + الصينية + الرومانية
# ========================================================================
# (تبقى كما هي لأنها أرقام حقيقية للكتابة المالية)

key <KP7> { [ 7, U4E03, U2166, U277C ] }; // 7 七 Ⅶ ❼
key <KP8> { [ 8, U516B, U2167, U277D ] }; // 8 八 Ⅷ ❽
key <KP9> { [ 9, U4E5D, U2168, U277E ] }; // 9 九 Ⅸ ❾
key <KP4> { [ 4, U56DB, U2163, U2779 ] }; // 4 四 Ⅳ ❹
key <KP5> { [ 5, U4E94, U2164, U277A ] }; // 5 五 Ⅴ ❺
key <KP6> { [ 6, U516D, U2165, U277B ] }; // 6 六 Ⅵ ❻
key <KP1> { [ 1, U4E00, U2160, U2776 ] }; // 1 一 Ⅰ ❶
key <KP2> { [ 2, U4E8C, U2161, U2777 ] }; // 2 二 Ⅱ ❷
key <KP3> { [ 3, U4E09, U2162, U2778 ] }; // 3 三 Ⅲ ❸
key <KP0> { [ 0, U96F6, U2169, U277F ] }; // 0 零 Ⅹ ❿
